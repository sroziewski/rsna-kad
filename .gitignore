export/
logs/

# Large or derived data. Small configs, manifests, calibration/stats json and the fold table stay tracked.
data/labels/*.jsonl
data/labels/*.parquet
data/labels/*.csv
data/targets/**/*.parquet
analysis/out/

# Binary payloads that never belong in git
*.npy
*.safetensors
*.pt
*.whl
*.dcm
*.so
*.so.*

